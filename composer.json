{
    "name": "componenta/validation",
    "description": "Validation rules, native attributes and declarative validator maps",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "validation",
        "validator",
        "attributes",
        "rules",
        "validation-provider",
        "php84"
    ],
    "require": {
        "php": "^8.4",
        "componenta/arrayable": "^1.0",
        "componenta/config": "^3.0.0",
        "componenta/mimetype-detector": "^1.0",
        "cycle/database": "^2.15",
        "giggsey/libphonenumber-for-php": "^9.0",
        "psr/container": "^2.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "Componenta\\Validation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Componenta\\Validation\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "@php vendor/bin/phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "branch-alias": {
            "dev-main": "3.0.x-dev"
        },
        "componenta": {
            "config-providers": [
                "Componenta\\Validation\\ConfigProvider"
            ]
        }
    }
}
